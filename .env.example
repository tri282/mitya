# api keys
GOOGLE_API_KEY=google_api_key
OLLAMA_BASE_URL=http://localhost:11434

# config
TESSERACT_PATH=path/to/tesseract.exe
MODEL_NAME=models/gemini-3.1-flash-lite

# local generation
LLM_BACKEND=gemini

# rag teacher (offline artifact builds -- scripts/build_entities.py, build_summaries.py)
# Free-tier quotas are per-model and are NOT derivable from the model id; read them
# off https://aistudio.google.com/rate-limit and set them here if you change model.
# Defaults below match models/gemini-3.1-flash-lite.
TEACHER_MODEL=models/gemini-3.1-flash-lite
TEACHER_RPM=15
TEACHER_TPM=250000
TEACHER_RPD=500
TEACHER_MAX_RETRIES=3

# rag judge (answer-quality eval -- scripts/eval_quality.py, probe_judge_variance.py)
# JUDGE_MODEL's quota is looked up in Config.MODEL_LIMITS; an unlisted id falls back
# to the STRICT tier (5 rpm / 20 rpd) with a warning rather than guessing high.
# Set JUDGE_RPM/TPM/RPD only to override that table (raised limits, paid key).
#
#   flash tier      (3.7 / 3.6 / 3.5 / 3):     5 rpm, 250k tpm,  20 rpd  <- 20 calls A DAY
#   flash-lite tier (3.5-lite / 3.1-lite):    15 rpm, 250k tpm, 500 rpd  <- the only batch tier
#
# Every v1 quality number was measured on gemini-3.1-flash-lite. Changing JUDGE_MODEL
# changes the instrument and breaks comparability with the frozen baseline (charter II).
JUDGE_MODEL=models/gemini-3.1-flash-lite
# JUDGE_RPM=
# JUDGE_TPM=
# JUDGE_RPD=

# --- Tracing / operator plane -----------------------------------------------
# Export is OPT-IN. With no endpoint the SDK builds spans and DROPS them
# (src/observability.py:469) -- the app runs fine, Jaeger just stays empty and
# every request_id looks like a 404 in its search bar. Point this at the
# jaeger service's OTLP HTTP collector (docker-compose.yml:31). The exporter
# appends /v1/traces itself, so give it the bare origin.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# api keys
GOOGLE_API_KEY=google_api_key
OLLAMA_BASE_URL=http://localhost:11434

# config
TESSERACT_PATH=path/to/tesseract.exe
MODEL_NAME=models/gemini-3.1-flash-lite

# local generation
LLM_BACKEND=gemini

# rag teacher (offline artifact builds -- scripts/build_entities.py, build_summaries.py)
# Free-tier quotas are per-model and are NOT derivable from the model id; read them
# off https://aistudio.google.com/rate-limit and set them here if you change model.
# Defaults below match models/gemini-3.1-flash-lite.
TEACHER_MODEL=models/gemini-3.1-flash-lite
TEACHER_RPM=15
TEACHER_TPM=250000
TEACHER_RPD=500
TEACHER_MAX_RETRIES=3
